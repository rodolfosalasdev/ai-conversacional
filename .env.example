# =============================================================================
# LLM — todos opcionais. Sem nenhuma chave o app roda com o motor determinístico
# (o grafo, o contrato e o e-mail continuam funcionando de ponta a ponta).
# =============================================================================

# Groq — grátis, recomendado. ~30 req/min, sem cartão de crédito.
# https://console.groq.com/keys
GROQ_API_KEY=

# Claude (Anthropic) — opcional, pago.
# CLAUDE_API_KEY=

# Google AI Studio (Gemini) — grátis, contexto longo.
# GEMINI_API_KEY=

# OpenRouter — um único token para dezenas de modelos ":free".
# OPENROUTER_API_KEY=

OPENROUTER_SITE_URL=http://localhost:3000

# Outros providers:
# OPENAI_API_KEY=
# CEREBRAS_API_KEY=

# Modelo local via Ollama (defina a URL para ativar).
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Fixa um provedor específico em vez da ordem automática de preferência.
# LLM_PROVIDER=groq

# Sobrescreve o modelo Groq usado pela interface.
# LLM_MODEL_GPT=openai/gpt-oss-20b

LLM_TIMEOUT_MS=20000
# LLM_NATURALIZE=0  # 1 = modelo reescreve o texto do grafo (padrão), 0 = texto canônico

# =============================================================================
# RAG — serviço Python opcional (veja rag-service/README.md).
# Sem ele, a busca usa o retriever BM25 em TypeScript.
# =============================================================================
# RAG_SERVICE_URL=http://localhost:8000
RAG_TIMEOUT_MS=4000

# =============================================================================
# Web Search — usado no modo Web do chat.
# Configure pelo menos uma chave. Tavily é recomendado (feito para LLM, ~1000
# buscas/mês grátis em https://tavily.com). Serper usa Google Search API.
# =============================================================================
TAVILY_API_KEY=
# SERPER_API_KEY=
WEB_SEARCH_TIMEOUT_MS=8000

# =============================================================================
# E-mail do contrato. Sem configuração, a cópia fica disponível como
# pré-visualização em /api/contracts/<id>/preview.
# =============================================================================

# Opção 1 — Resend (camada gratuita de 3.000 e-mails/mês).
RESEND_API_KEY=
EMAIL_FROM="Banco Salas <onboarding@resend.dev>"

# Opção 2 — SMTP próprio.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Opção 3 — Ethereal: caixa de teste online criada na hora, sem cadastro.
# EMAIL_TRANSPORT=ethereal

# Redireciona todos os envios para um endereço só, útil em testes.
# EMAIL_OVERRIDE_TO=voce@exemplo.com

# =============================================================================
# Persistência das conversas em .data/ (0 desativa e mantém tudo em memória).
# =============================================================================
CONVERSATION_PERSIST=1
